<.analytics_exception_day_controls
  exception_days={@exception_days}
  exclude_exception_days?={@exclude_exception_days?}
/>

<%!-- Period pickers --%>
<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
  <form phx-submit="filter_a" class="rounded-lg border border-blue-200 bg-blue-50 p-4">
    <h2 class="mb-3 text-sm font-bold text-blue-700">Period A</h2>
    <div class="flex flex-wrap items-center gap-3">
      <div class="flex items-center gap-2">
        <label class="text-xs font-semibold text-blue-600">From</label>
        <input type="date" name="from" value={@from_a} class="rounded border border-blue-300 px-2 py-1 text-sm" />
      </div>
      <div class="flex items-center gap-2">
        <label class="text-xs font-semibold text-blue-600">To</label>
        <input type="date" name="to" value={@to_a} class="rounded border border-blue-300 px-2 py-1 text-sm" />
      </div>
      <button type="submit" class="rounded bg-blue-600 px-3 py-1 text-xs font-semibold text-white hover:bg-blue-700">Apply</button>
    </div>
  </form>

  <form phx-submit="filter_b" class="rounded-lg border border-amber-200 bg-amber-50 p-4">
    <h2 class="mb-3 text-sm font-bold text-amber-700">Period B</h2>
    <div class="flex flex-wrap items-center gap-3">
      <div class="flex items-center gap-2">
        <label class="text-xs font-semibold text-amber-600">From</label>
        <input type="date" name="from" value={@from_b} class="rounded border border-amber-300 px-2 py-1 text-sm" />
      </div>
      <div class="flex items-center gap-2">
        <label class="text-xs font-semibold text-amber-600">To</label>
        <input type="date" name="to" value={@to_b} class="rounded border border-amber-300 px-2 py-1 text-sm" />
      </div>
      <button type="submit" class="rounded bg-amber-500 px-3 py-1 text-xs font-semibold text-white hover:bg-amber-600">Apply</button>
    </div>
  </form>
</div>

<%!-- KPI comparison --%>
<div class="mt-6 grid grid-cols-2 gap-2 sm:grid-cols-4 lg:grid-cols-8">
  <%= for {label, key, fmt} <- [
    {"Trades", :trade_count, &"#{&1}"},
    {"Win Rate", :win_rate, &"#{Float.round(&1 * 100, 1)}%"},
    {"Total R", :total_r, &"#{&1}R"},
    {"Avg R", :avg_r, &"#{&1}R"},
    {"Best R", :best_r, &"#{&1}R"},
    {"Worst R", :worst_r, &"#{&1}R"},
    {"Profit Factor", :profit_factor, &"#{&1}"},
    {"Expectancy", :expectancy, &"#{&1}R"}
  ] do %>
    <% val_a = Map.get(@kpis_a, key, 0)
       val_b = Map.get(@kpis_b, key, 0)
       {dir, delta_str} = kpi_delta(val_a, val_b) %>
    <div class="rounded-lg border border-zinc-200 bg-white p-3 shadow-sm">
      <p class="text-[10px] font-semibold uppercase tracking-wider text-zinc-400"><%= label %></p>
      <p class="mt-0.5 text-base font-bold text-blue-700"><%= fmt.(val_a) %></p>
      <p class="text-xs text-amber-600"><%= fmt.(val_b) %></p>
      <%= if delta_str != "" do %>
        <p class={["mt-0.5 text-[10px] font-semibold", case dir do :up -> "text-emerald-600"; :down -> "text-rose-600"; _ -> "text-zinc-400" end]}>
          <%= delta_str %>
        </p>
      <% end %>
    </div>
  <% end %>
</div>

<%!-- Overlaid equity chart --%>
<div class="mt-6">
  <h2 class="mb-2 text-sm font-semibold uppercase tracking-wider text-zinc-500">
    Equity Curves (re-zeroed from period start)
  </h2>
  <.chart id="compare-equity" option={@compare_option} class="w-full h-72" />
</div>
