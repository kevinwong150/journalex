<.analytics_filter_bar
  versions_available={@versions_available}
  selected_versions={@selected_versions}
  from={@from}
  to={@to}
  r_mode={@r_mode}
  exception_days={@exception_days}
  exclude_exception_days?={@exclude_exception_days?}
/>

<div class="mt-6 flex items-center justify-between gap-4">
  <h2 class="text-sm font-semibold uppercase tracking-wider text-zinc-500">
    Ticker Leaderboard (<%= length(@tickers) %> tickers)
  </h2>
  <input
    type="search"
    name="q"
    value={@search_q}
    phx-change="search"
    placeholder="Filter ticker…"
    class="rounded border border-zinc-300 px-3 py-1 text-sm focus:outline-none focus:ring-2 focus:ring-zinc-400"
  />
</div>

<div class="mt-3 overflow-x-auto">
  <table class="min-w-full text-sm">
    <thead>
      <tr class="border-b border-zinc-200 text-left text-xs font-semibold uppercase tracking-wider text-zinc-500">
        <th class="pb-2 pr-4">#</th>
        <th class="pb-2 pr-4">Ticker</th>
        <th class="pb-2 pr-4 text-right">Trades</th>
        <th class="pb-2 pr-4 text-right">Win%</th>
        <th class="pb-2 pr-4 text-right">Total R</th>
        <th class="pb-2 pr-4 text-right">Avg R</th>
        <th class="pb-2 text-right">Last Trade</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-zinc-100">
      <%= for {{ticker, count, win_rate, total_r, avg_r, last_date}, idx} <- Enum.with_index(@filtered_tickers, 1) do %>
        <tr class="hover:bg-zinc-50">
          <td class="py-2 pr-4 text-zinc-400"><%= idx %></td>
          <td class="py-2 pr-4 font-semibold text-zinc-800"><%= ticker %></td>
          <td class="py-2 pr-4 text-right text-zinc-600"><%= count %></td>
          <td class="py-2 pr-4 text-right text-zinc-600"><%= Float.round(win_rate * 100, 1) %>%</td>
          <td class={["py-2 pr-4 text-right font-semibold", if(total_r >= 0, do: "text-emerald-600", else: "text-rose-600")]}>
            <%= total_r %>R
          </td>
          <td class={["py-2 pr-4 text-right", if(avg_r >= 0, do: "text-emerald-600", else: "text-rose-600")]}>
            <%= avg_r %>R
          </td>
          <td class="py-2 text-right text-zinc-500">
            <%= if last_date, do: Date.to_iso8601(last_date), else: "—" %>
          </td>
        </tr>
      <% end %>
      <%= if @filtered_tickers == [] do %>
        <tr>
          <td colspan="7" class="py-6 text-center text-zinc-400">No tickers found.</td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

